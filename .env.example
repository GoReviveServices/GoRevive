# Copy to .env.local (or set in your host's dashboard) and fill in real values.
# Never commit real secrets.

# --- Site ---------------------------------------------------------------
# Public URL of the live site. Used for canonical URLs, sitemap, Open Graph
# and payment return URLs. Use your real domain (www or not — pick one).
NEXT_PUBLIC_SITE_URL=https://www.gorevive.in
# Where product/banner images are served from.
NEXT_PUBLIC_IMAGE_HOST=https://gorevive.jbbs.in
# Set to "false" on staging/preview so search engines don't index it.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Redirect http -> https (only once your proxy/LB sends X-Forwarded-Proto).
ENFORCE_HTTPS=false
# Redirect other hostnames (e.g. gorevive.in) to NEXT_PUBLIC_SITE_URL's host.
# Needs ENFORCE_HTTPS=true as well.
ENFORCE_CANONICAL_HOST=false

# Optional: serve /_next/static from a CDN, e.g. https://cdn.gorevive.in
ASSET_PREFIX=

# Search engine verification codes (meta-tag method)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Auth -----------------------------------------------------------------
# Long random string (at least 32 chars): openssl rand -base64 48
JWT_SECRET=

# --- PHP backend -----------------------------------------------------------
PHP_API_BASE_URL=
PHP_STATIC_TOKEN=
PHP_STATIC_TOKEN_CHECKOUT=
PHP_ASC_CODE=GRWHDL001
PHP_TIMEOUT_MS=15000
# Which inventory price field customers pay. Confirm with the backend team.
PRICE_FIELD=Cust_Price
# How long inventory is cached on the server (ms).
INVENTORY_CACHE_MS=60000

# --- Payments --------------------------------------------------------------
CASHFREE_BASE_URL=https://api.cashfree.com/pg
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "production" for live payments, anything else = sandbox
NEXT_PUBLIC_CASHFREE_MODE=production

HDFC_BASE_URL=
HDFC_API_KEY=
HDFC_MERCHANT_ID=
NEXT_PUBLIC_HDFC_CLIENT_ID=

# Publish prices in Google product rich results (prices are login-only today).
PUBLIC_PRICES_IN_SCHEMA=false
