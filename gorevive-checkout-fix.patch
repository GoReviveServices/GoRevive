 # Copy to .env.local (or set in your host's dashboard) and fill in real values.
 # Never commit real secrets.
+#
+# Rules that have caused real checkout failures:
+#  - List every variable ONCE. When a name appears twice, the LAST line wins, so
+#    a blank "HDFC_API_KEY=" further down silently wipes out a filled one above.
+#  - Do not set NODE_ENV here; Next.js sets it for dev / build / start.
+#  - Local development: NEXT_PUBLIC_SITE_URL=http://localhost:3000 and the Cashfree
+#    SANDBOX url + sandbox keys (see the Payments section below).
 
 # --- Site ---------------------------------------------------------------
 # Public URL of the live site. Used for canonical URLs, sitemap, Open Graph
@@ -43,9 +50,13 @@ CASHFREE_BASE_URL=https://api.cashfree.com/pg
 CASHFREE_APP_ID=
 CASHFREE_SECRET_KEY=
 # Cashfree mode is derived from CASHFREE_BASE_URL (no separate setting needed):
-#   live:    https://api.cashfree.com/pg
-#   sandbox: https://sandbox.cashfree.com/pg   (use sandbox App ID / Secret with it)
+#   live:    https://api.cashfree.com/pg       + live App ID / cfsk_ma_prod_... secret
+#   sandbox: https://sandbox.cashfree.com/pg   + TEST... App ID / cfsk_ma_test_... secret
+# A session created in one environment is invalid in the other, so keep the URL,
+# App ID and Secret from the same environment.
 
+# HDFC SmartGateway (UAT: https://smartgateway.hdfcuat.bank.in). The server
+# supports it; the checkout page currently only offers Cashfree buttons.
 HDFC_BASE_URL=
 HDFC_API_KEY=
 HDFC_MERCHANT_ID=
