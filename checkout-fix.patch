+/**
+ * "production" when the server talks to api.cashfree.com, otherwise "sandbox".
+ * A session created on one environment is invalid on the other.
+ */
+export function getCashfreeMode() {
+    const baseUrl = String(process.env.CASHFREE_BASE_URL || '').trim();
+    return /\/\/api\.cashfree\.com/i.test(baseUrl) ? 'production' : 'sandbox';
+}
