From 6a89d5ebc319a4b312f0897e532edd73768adb73 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 16:37:38 +0000
Subject: [PATCH] Fix checkout: derive Cashfree mode from server config and
 validate session id

The browser SDK mode came from NEXT_PUBLIC_CASHFREE_MODE while the server
used CASHFREE_BASE_URL, so a mismatch produced payment_session_id_invalid.
The server now returns the mode it created the order in, and rejects
responses with no payment_session_id.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Uw69FYH9MNAv83tz2dPjEw
---
 .env.example                  |  5 +++--
 src/app/api/checkout/route.js |  1 +
 src/app/checkout/page.js      | 12 ++++++++++--
 src/lib/paymentHelpers.js     | 17 +++++++++++++++--
 4 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/.env.example b/.env.example
index eba960e..a9f20f7 100644
--- a/.env.example
+++ b/.env.example
@@ -42,8 +42,9 @@ INVENTORY_CACHE_MS=60000
 CASHFREE_BASE_URL=https://api.cashfree.com/pg
 CASHFREE_APP_ID=
 CASHFREE_SECRET_KEY=
-# "production" for live payments, anything else = sandbox
-NEXT_PUBLIC_CASHFREE_MODE=production
+# Cashfree mode is derived from CASHFREE_BASE_URL (no separate setting needed):
+#   live:    https://api.cashfree.com/pg
+#   sandbox: https://sandbox.cashfree.com/pg   (use sandbox App ID / Secret with it)
 
 HDFC_BASE_URL=
 HDFC_API_KEY=
diff --git a/src/app/api/checkout/route.js b/src/app/api/checkout/route.js
index 00993d5..79d6189 100644
--- a/src/app/api/checkout/route.js
+++ b/src/app/api/checkout/route.js
@@ -92,6 +92,7 @@ export async function POST(request) {
             gateway,
             paymentUrl: payment.paymentUrl,
             sessionId: payment.sessionId,
+            cashfreeMode: payment.mode,
         });
         await setPendingOrder(response, order);
         dlog('checkout: pending-order cookie set', { orderId: order.orderId, httpsOnlyFlag: process.env.NODE_ENV === 'production' });
diff --git a/src/app/checkout/page.js b/src/app/checkout/page.js
index d32f7de..b2fbafb 100644
--- a/src/app/checkout/page.js
+++ b/src/app/checkout/page.js
@@ -287,14 +287,22 @@ export default function CheckoutPage() {
             }
 
             // Cashfree checkout script is loaded only when the buyer pays.
+            if (!data.sessionId) {
+                toast.error('Payment session could not be created. Please try again.', { id: toastId });
+                setIsInitiatingPayment(false);
+                return;
+            }
+
             const { load } = await import('@cashfreepayments/cashfree-js');
-            const cashfree = await load({ mode: process.env.NEXT_PUBLIC_CASHFREE_MODE === 'production' ? 'production' : 'sandbox' });
+            // Use the mode the server created the session in; a mismatch makes Cashfree
+            // reject the session as invalid.
+            const cashfree = await load({ mode: data.cashfreeMode === 'production' ? 'production' : 'sandbox' });
             toast.dismiss(toastId);
 
             const result = await cashfree.checkout({ paymentSessionId: data.sessionId, redirectTarget: '_modal' });
             console.log('[checkout-debug] Cashfree modal finished', { error: result?.error || null, paymentDetails: result?.paymentDetails || null, redirect: Boolean(result?.redirect) });
 
-            if (result.error) {
+            if (result?.error) {
                 toast.error('Payment failed: ' + result.error.message);
                 setIsInitiatingPayment(false);
             } else {
diff --git a/src/lib/paymentHelpers.js b/src/lib/paymentHelpers.js
index d29c6ce..c87db8d 100644
--- a/src/lib/paymentHelpers.js
+++ b/src/lib/paymentHelpers.js
@@ -13,11 +13,17 @@ function cashfreeEnv() {
         appIdPrefix: String(process.env.CASHFREE_APP_ID || '').slice(0, 4),
         hasAppId: Boolean(process.env.CASHFREE_APP_ID),
         keyEnvironment: (secret.match(/^cfsk_ma_(test|prod)/) || [])[1] || (secret ? 'unrecognised' : 'MISSING'),
-        browserMode: process.env.NEXT_PUBLIC_CASHFREE_MODE || '(unset = sandbox)',
+        browserMode: getCashfreeMode(),
         siteUrl: process.env.NEXT_PUBLIC_SITE_URL,
     };
 }
 
+// "production" when the server talks to api.cashfree.com, otherwise "sandbox".
+// A session created in one environment is invalid in the other.
+export function getCashfreeMode() {
+    return /\/\/api\.cashfree\.com/i.test(String(process.env.CASHFREE_BASE_URL || '').trim()) ? 'production' : 'sandbox';
+}
+
 // Cashfree session ids end in "payment" exactly once. The API sometimes returns
 // "...paymentpayment", and the checkout pop-up then shows "Something went wrong".
 export function cleanCashfreeSessionId(id) {
@@ -174,8 +180,15 @@ export async function createCashfreeOrder({ orderId, amount, customerId, phone,
             sessionIdWasTrimmed: sessionId !== rawSessionId,
         });
 
+        if (!sessionId) {
+            throw new Error(data?.message || 'Cashfree did not return a payment session');
+        }
+
         return {
-            sessionId
+            sessionId,
+            // Same environment the order was just created in, so the browser SDK
+            // can never target a different one than the server.
+            mode: getCashfreeMode(),
         };
     } catch (error) {
         dlog('Cashfree !! create order FAILED', { ...describeGatewayError(error), env: cashfreeEnv() });
-- 
2.43.0

