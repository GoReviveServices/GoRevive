+}
+
+/** Flipkart-style "highlights": the specs a buyer scans first, as chips. */
+export function SpecHighlights({ specs }) {
+    const rows = [
+        [Cpu, specs?.processor],
+        [MemoryStick, specs?.ram && `${specs.ram} RAM`],
+        [HardDrive, specs?.storage],
+        [Monitor, specs?.display],
