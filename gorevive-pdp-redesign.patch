+                </div>
+            </div>
+            <ul ref={trackRef} onScroll={onScroll} className="flex snap-x snap-mandatory gap-2.5 overflow-x-auto scroll-smooth pb-0.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
