+                        </dt>
+                        <dd className="break-words border-t border-[#EEF3F0] px-3 py-2.5 text-[#0B2136]">{String(specs[key])}</dd>
+                    </div>
+                ))}
+            </dl>
+        </section>
+    );
+}
